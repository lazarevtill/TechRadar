# Server-side configuration for a VPS deployment. Copy to .env in the repo
# root on the server (never commit it). Everything is optional except DOMAIN
# and ADMIN_TOKEN, which an internet-facing server must have.

# Public hostname; DNS must point at this server (Caddy gets the certificate).
DOMAIN=radar.example.com
# Default server address baked into the downloadable extension.
EXTENSION_BACKEND_URL=https://radar.example.com

# Operator token (long random string: openssl rand -hex 32).
ADMIN_TOKEN=

# Jev judgments (categories, novelty, topics, discovery). Without it the feed
# works, unclassified and ranked from engagement only.
TYPESAFE_API_KEY=
# More GitHub searches per refresh (no scopes needed).
GITHUB_TOKEN=
# Contact emails: tenfold translation quota, OpenAlex polite pool.
MYMEMORY_EMAIL=
OPENALEX_MAILTO=

# Webhooks, posted as {"text": "..."} (Slack, Mattermost, n8n, ...).
REPORT_WEBHOOK_URL=
REPORT_WATCH=
WATCH_WEBHOOK_URL=
ALERT_WEBHOOK_URL=
PUBLIC_BASE_URL=https://radar.example.com
