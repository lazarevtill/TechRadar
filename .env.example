# Optional — analytics/instrumentation script injected in <head>
VITE_INSTRUMENTATION_SCRIPT_SRC=

# TypeSafe (Jev) key. The dashboard server uses it to categorize live feed
# items (without it they show as "Unclassified"); `generate:feed` requires it
# to tag trend topics. Server/CI only — never expose it to client code.
# TYPESAFE_API_KEY=

# Only required for local `bun run generate:feed` (not needed for dev server)
# ANTHROPIC_API_KEY=

# Digest model for `bun run generate:feed`. One of: claude-haiku-4-5 (default,
# ~$1.30/month) or claude-sonnet-5 (~$6/month). See scripts/generate-feed/model.ts.
# DIGEST_MODEL=claude-haiku-4-5

# Only needed if ANTHROPIC_API_KEY is an org-level key rather than a
# workspace-scoped one. Org keys are rejected without this header.
# ANTHROPIC_WORKSPACE_ID=wrkspc_...

# The digest uses the Message Batches API (50% cheaper) by default. Set to 0 to
# force synchronous calls, e.g. when debugging.
# DIGEST_BATCH=0
# How long to wait for a batch before falling back to synchronous calls.
# DIGEST_BATCH_TIMEOUT_MIN=90
