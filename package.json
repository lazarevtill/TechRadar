  "devDependencies": {
    "@tanstack/eslint-config": "^0.3.0",
    "@tanstack/nitro-v2-vite-plugin": "^1.155.2",
    "@tanstack/router-cli": "^1.167.38",
    "@types/bun": "^1.4.2",
    "@types/node": "^22.12.0",
    "@types/react": "^19.3.0",
