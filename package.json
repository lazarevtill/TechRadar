{
  "name": "template-tanstack-start",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev --port 3000",
    "start": "bun run server.ts",
    "build": "tsr generate && tsc --noEmit && vite build --sourcemap",
    "build:node": "tsr generate && FOR_SITES=true vite build",
    "serve": "vite preview",
    "test": "vitest run",
    "test:parsers": "bun run src/server/functions/__tests__/run-tests.ts",
    "lint": "eslint",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "generate:routes": "tsr generate",
    "generate:feed": "bun run scripts/generate-feed/index.ts",
    "check:secrets": "bun run scripts/check-no-secrets.ts",
    "clean": "rm -rf .output dist node_modules/.vite .nitro .tanstack"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.126.0",
